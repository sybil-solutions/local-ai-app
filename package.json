{
  "name": "local-ai",
  "productName": "Local AI",
  "version": "0.7.15",
  "description": "Start a local model with one click, watch it run, and open your coding agent on it.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.js",
    "dist": "electron-builder",
    "lint": "eslint .",
    "test:integration": "node tests/integration.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "screens": "node tests/screens.mjs",
    "fuzz": "node tests/fuzz.mjs",
    "release:mac": "scripts/release-mac.sh",
    "release:win": "scripts/release-win.sh",
    "release:public": "scripts/publish.sh",
    "check": "eslint . && node tests/screens.mjs && node tests/fuzz.mjs && node tests/integration.mjs && node tests/e2e.mjs"
  },
  "build": {
    "appId": "ai.sybilsolutions.local",
    "productName": "Local AI",
    "copyright": "Copyright \u00a9 2026 Sybil Solutions",
    "icon": "electron/icon.png",
    "files": [
      "electron/**",
      "!electron/before-pack.cjs",
      "!electron/entitlements.mac.plist",
      "server/**",
      "web/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/payload",
        "to": "payload"
      }
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "notarize": true,
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Local AI connects to your other machines and to the models running on them.",
        "LSApplicationCategoryType": "public.app-category.developer-tools"
      }
    },
    "dmg": {
      "sign": true,
      "title": "Local AI ${version}",
      "artifactName": "Local-AI-${version}-${arch}.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Local-AI-${version}-${arch}.exe"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    },
    "beforePack": "electron/before-pack.cjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  },
  "author": "Sybil Solutions",
  "homepage": "https://github.com/sybil-solutions/local-ai-app"
}
